{
  "name": "recodr",
  "version": "1.7.11",
  "description": "Video re-encoder with GUI using ffmpeg",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node scripts/run-unit-tests.js",
    "test:electron": "node scripts/run-electron-smoke.js",
    "prebuild": "node scripts/prepare-build.js",
    "build": "node scripts/build.js",
    "prebuild:win": "node scripts/prepare-build.js",
    "build:win": "node scripts/build.js --win",
    "prebuild:mac": "node scripts/prepare-build.js",
    "build:mac": "node scripts/build.js --mac",
    "prebuild:linux": "node scripts/prepare-build.js",
    "build:linux": "node scripts/build.js --linux",
    "prebuild:full": "node scripts/prepare-build.js",
    "build:full": "node scripts/build.js --win --mac --linux"
  },
  "keywords": [
    "video",
    "encoder",
    "ffmpeg",
    "electron"
  ],
  "author": "heckr.dev <jesse@heckr.dev>",
  "license": "GPL-2.0-only",
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "dev.heckr.recodr",
    "productName": "reCodr",
    "directories": {
      "buildResources": "assets",
      "output": "release"
    },
    "files": [
      "*.js",
      "index.html",
      "renderer.js",
      "styles.css",
      "assets/**/*",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "assets/icon.ico",
        "to": "assets/icon.ico"
      },
      {
        "from": "assets/icon.icns",
        "to": "assets/icon.icns"
      },
      {
        "from": "assets/icon.png",
        "to": "assets/icon.png"
      }
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "assets/icon.ico"
    },
    "portable": {
      "artifactName": "${productName}-${version}-windows-${arch}-portable.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "artifactName": "${productName}-${version}-windows-${arch}-setup.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/icon.icns",
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/icon.png",
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}"
    }
  }
}
